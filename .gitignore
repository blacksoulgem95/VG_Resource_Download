# ---------------------------------------------------------------------------
# Ambiente Python/launcher (generati automaticamente, non versionare)
# ---------------------------------------------------------------------------
.venv/
__pycache__/
*.py[cod]
*.egg-info/

# Copia locale di tkinter preparata da download.sh (senza sudo)
.tk-bundle/

# Profilo Chrome persistente: contiene il cookie cf_clearance e cache del
# browser, quindi dati locali e potenzialmente sensibili
.chrome-profile/

# ---------------------------------------------------------------------------
# File scaricati
#
# La destinazione predefinita è download/<Gioco>/<Sezione>/. Le cartelle con
# gli asset sono dati, non codice.
# ---------------------------------------------------------------------------
download/

# Cartelle di download fatte in passato nella radice del progetto
# (vecchio comportamento, prima di download/ e delle sottocartelle per sezione)
Kingdom_Hearts_II/
Disney_Solitaire/
Fallout_New_Vegas/

# Download parziali
*.part

# ---------------------------------------------------------------------------
# Sistema operativo / editor
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
*.swp
*~
.idea/
.vscode/
