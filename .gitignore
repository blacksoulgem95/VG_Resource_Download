# ---------------------------------------------------------------------------
# Ambiente Python/launcher (generati automaticamente, non versionare)
# ---------------------------------------------------------------------------
.venv/
.build-venv/
__pycache__/
*.py[cod]
*.egg-info/

# Copia locale di tkinter preparata da download.sh (senza sudo)
.tk-bundle/

# Profilo Chrome persistente: contiene il cookie cf_clearance e cache del
# browser, quindi dati locali e potenzialmente sensibili
.chrome-profile/

# ---------------------------------------------------------------------------
# File scaricati
#
# La destinazione predefinita è download/<Gioco>/<Sezione>/. Le cartelle con
# gli asset sono dati, non codice.
# ---------------------------------------------------------------------------
download/

# Download parziali
*.part

# ---------------------------------------------------------------------------
# Build / packaging
#
# dist/ contiene i bundle PyInstaller (~200 MB l'uno) e packaging/build/ gli
# artefatti intermedi. Le icone native in packaging/icons/ sono invece
# generate ma versionate, perché servono ai runner senza Pillow: per
# rigenerarle basta `python packaging/make_icons.py`.
# ---------------------------------------------------------------------------
dist/
build/
packaging/build/
*.spec.bak
appimagetool*.AppImage
*.AppDir/

# Log delle build
pyinstaller.log

# ---------------------------------------------------------------------------
# Sistema operativo / editor
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
*.swp
*~
.idea/
.vscode/
